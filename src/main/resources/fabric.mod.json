{
    "schemaVersion": 1,
    "id": "flashbackinspector",
    "version": "${version}",
    "name": "Flashback Inspector",
    "description": "Records what you were carrying and what was inside every container you opened, and gives the Flashback replay a read-only inventory screen to look at it. Port to 1.21.11 of the original mod by Glam_Ardor.",
    "authors": [
        "Glam_Ardor",
        "hugoxeneize (1.21.11 port)"
    ],
    "contact": {
        "homepage": "https://codeberg.org/Glam_Ardor/flashback-inspector",
        "sources": "https://github.com/hugoxeneize/flashback-inspector",
        "issues": "https://github.com/hugoxeneize/flashback-inspector/issues"
    },
    "license": "LGPL-3.0-or-later",
    "icon": "assets/flashbackinspector/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.glamardor.flashbackinspector.FlashbackInspector"
        ],
        "modmenu": [
            "com.glamardor.flashbackinspector.compat.InspectorModMenu"
        ]
    },
    "mixins": [
        {
            "config": "flashbackinspector.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.16.0",
        "minecraft": ">=1.21.11 <1.22",
        "fabric-api": "*",
        "flashback": ">=0.39.0",
        "java": ">=21"
    },
    "suggests": {
        "cloth-config": "*",
        "modmenu": "*"
    }
}
